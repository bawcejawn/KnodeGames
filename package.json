{
  "name": "knode-games",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "description": "Knode Games: prediction games on Koinos \u2014 the website, the operator bot, the question generator and analysis tools",
  "type": "module",
  "private": true,
  "scripts": {
    "backtest": "tsx backtest.ts",
    "generate": "tsx generator.ts",
    "export-blocks": "tsx export-blocks.ts",
    "bot": "tsx bot/bot.ts",
    "test:resolver": "node --import tsx --test resolver.test.ts",
    "test:audit": "node --import tsx --test tests/audit/*.test.ts tests/audit/*.test.mjs tests/audit/repolens-r4-publish/*.test.mjs tests/audit/repolens-r5-publish/*.test.mjs tests/audit/repolens-r6-publish/*.test.mjs",
    "test:audit:serial": "node --import tsx --test --test-concurrency=1 tests/audit/*.test.ts tests/audit/*.test.mjs tests/audit/repolens-r4-publish/*.test.mjs tests/audit/repolens-r5-publish/*.test.mjs tests/audit/repolens-r6-publish/*.test.mjs",
    "desk": "tsx bot/desk.ts",
    "admin": "tsx admin/server.ts",
    "heal": "node bot/heal.mjs",
    "sponsor": "tsx bot/sponsor.ts",
    "race": "tsx bot/race.ts",
    "racepicks": "tsx bot/race-picks.ts",
    "blockx": "tsx bot/games/blockx.ts",
    "picks": "tsx bot/picks.ts",
    "testnet-site": "node tools/testnet-site.mjs",
    "names": "tsx bot/names.ts",
    "prizes": "tsx bot/free-prizes.ts",
    "game:new": "node tools/new-game.mjs",
    "game:check": "node tools/game-check.mjs"
  },
  "dependencies": {
    "koilib": "9.4.1"
  },
  "devDependencies": {
    "@koinos/mock-vm": "1.3.0",
    "@koinos/proto-js": "2.1.0",
    "jsdom": "24.1.3",
    "tsx": "4.23.15",
    "yaml": "2.6.1"
  }
}
